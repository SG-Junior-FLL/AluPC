[Desktop Entry]
Type=Application
Name=AluPC
GenericName=Monitor 2 steuern
Comment=Zweiten Monitor steuern: Spiegeln, Kamera, Programme, Websites, Szenen, Standbild
Exec=alupc
Icon=alupc
Terminal=false
StartupWMClass=AluPC
# Erlaubt KWin-Bildschirmaufnahme ohne Nachfrage (Spiegeln unter KDE/Wayland); gilt nur, wenn
# Exec= auf genau die laufende Programmdatei zeigt (setzt das .deb bzw. AluPC beim ersten Start)
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Categories=Utility;
Keywords=Monitor;Beamer;Bildschirm;Spiegeln;Szene;
Actions=Standbild;Schwarz;BildInBild;Bildschirmschoner;Spiegeln;Erweitern;NaechsteSzene;VorherigeSzene;TimerStartPause;Laserpointer;Sperren;

[Desktop Action Standbild]
Name=Standbild an/aus
Exec=alupc --befehl standbild

[Desktop Action Schwarz]
Name=Schwarz (Sichtschutz) an/aus
Exec=alupc --befehl schwarz

[Desktop Action BildInBild]
Name=Bild-in-Bild an/aus
Exec=alupc --befehl bild-in-bild

[Desktop Action Spiegeln]
Name=Spiegeln
Exec=alupc --befehl spiegeln

[Desktop Action Erweitern]
Name=Erweitern
Exec=alupc --befehl erweitern

[Desktop Action Bildschirmschoner]
Name=Bildschirmschoner an/aus
Exec=alupc --befehl bildschirmschoner

[Desktop Action NaechsteSzene]
Name=Nächste Szene
Exec=alupc --befehl naechste_szene

[Desktop Action VorherigeSzene]
Name=Vorherige Szene
Exec=alupc --befehl vorherige_szene

[Desktop Action TimerStartPause]
Name=Timer starten/pausieren
Exec=alupc --befehl timer_start_pause

[Desktop Action Laserpointer]
Name=Laserpointer an/aus
Exec=alupc --befehl laserpointer

[Desktop Action Sperren]
Name=Computer sperren
Exec=alupc --befehl sperren
